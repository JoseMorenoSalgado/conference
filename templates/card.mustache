{{!
    @template mod_conference/card

    Premium responsive conference card shown to participants.

    Example context (json):
    {
        "elementid": "mod-conference-card-10",
        "name": "Clinical nutrition conference",
        "coverurl": "https://example.com/conference.jpg",
        "hascover": true,
        "haspassword": true,
        "passwordlabel": "Access password",
        "passwordrequired": "Shown when you join",
        "conferenceonline": "Online conference",
        "providerlabel": "Provider",
        "provider": "Zoom",
        "providerkey": "zoom",
        "hasmeetingreference": true,
        "meetingreferencelabel": "Meeting ID",
        "meetingreference": "841 9709 3904",
        "meetinglinklabel": "Meeting link",
        "meetinglinkhint": "Opens in Zoom when you select Join conference.",
        "joinhelper": "The access password will be shown when you join the meeting.",
        "startlabel": "Scheduled start",
        "start": "30 September 2026, 7:00 PM",
        "hasend": true,
        "endlabel": "Scheduled end",
        "end": "30 September 2026, 8:00 PM",
        "status": "Available now",
        "statusclass": "success",
        "islive": true,
        "isscheduled": false,
        "isended": false,
        "joinurl": "https://example.com/mod/conference/join.php?id=10",
        "joinlabel": "Join conference",
        "scheduledmessage": "The conference link will be available at the scheduled time.",
        "endedmessage": "This conference has ended.",
        "refreshhint": "The join button will activate automatically.",
        "countdownprefix": "Starts in"
    }
}}
<div class="mod-conference-card" id="{{elementid}}">
    {{#hascover}}
        <div class="mod-conference-cover">
            <img src="{{coverurl}}" alt="">
        </div>
    {{/hascover}}

    <div class="mod-conference-body">
        <div class="mod-conference-toolbar">
            <div class="mod-conference-statusgroup">
                <div class="mod-conference-camera" aria-hidden="true">
                    {{#pix}} icon, mod_conference {{/pix}}
                </div>
                <span class="badge text-bg-{{statusclass}}" data-region="status-badge">{{status}}</span>
            </div>

            <span class="mod-conference-online">
                <span aria-hidden="true">{{#pix}} i/group, core {{/pix}}</span>
                <span>{{conferenceonline}}</span>
            </span>
        </div>

        <h2 class="mod-conference-title">{{name}}</h2>

        <div class="mod-conference-meta-grid">
            <div class="mod-conference-meta-card">
                <span class="mod-conference-meta-icon" aria-hidden="true">
                    {{#pix}} i/calendar, core {{/pix}}
                </span>
                <div class="mod-conference-meta-copy">
                    <span class="mod-conference-meta-label">{{startlabel}}</span>
                    <span class="mod-conference-meta-value">{{start}}</span>
                </div>
            </div>

            {{#hasmeetingreference}}
                <div class="mod-conference-meta-card">
                    <span class="mod-conference-meta-icon mod-conference-meta-symbol" aria-hidden="true">#</span>
                    <div class="mod-conference-meta-copy">
                        <span class="mod-conference-meta-label">{{meetingreferencelabel}}</span>
                        <span class="mod-conference-meta-value">{{meetingreference}}</span>
                    </div>
                </div>
            {{/hasmeetingreference}}

            {{#haspassword}}
                <div class="mod-conference-meta-card">
                    <span class="mod-conference-meta-icon" aria-hidden="true">
                        {{#pix}} t/locked, core {{/pix}}
                    </span>
                    <div class="mod-conference-meta-copy">
                        <span class="mod-conference-meta-label">{{passwordlabel}}</span>
                        <span class="mod-conference-meta-value">{{passwordrequired}}</span>
                    </div>
                </div>
            {{/haspassword}}

            <div class="mod-conference-meta-card">
                <span class="mod-conference-meta-icon" aria-hidden="true">
                    {{#pix}} icon, mod_conference {{/pix}}
                </span>
                <div class="mod-conference-meta-copy">
                    <span class="mod-conference-meta-label">{{providerlabel}}</span>
                    <span class="mod-conference-meta-value">{{provider}}</span>
                </div>
            </div>

            {{#hasend}}
                <div class="mod-conference-meta-card">
                    <span class="mod-conference-meta-icon" aria-hidden="true">
                        {{#pix}} i/calendar, core {{/pix}}
                    </span>
                    <div class="mod-conference-meta-copy">
                        <span class="mod-conference-meta-label">{{endlabel}}</span>
                        <span class="mod-conference-meta-value">{{end}}</span>
                    </div>
                </div>
            {{/hasend}}
        </div>

        <div class="mod-conference-linkstrip">
            <span class="mod-conference-linkicon" aria-hidden="true">
                {{#pix}} i/link, core {{/pix}}
            </span>
            <span class="mod-conference-linkcopy">
                <strong>{{meetinglinklabel}}</strong>
                <small>{{meetinglinkhint}}</small>
            </span>
        </div>

        <div class="mod-conference-action">
            <div data-region="live"{{^islive}} class="d-none"{{/islive}}>
                <a class="btn btn-primary btn-lg mod-conference-join"
                   href="{{joinurl}}"
                   target="_blank"
                   rel="noopener noreferrer">
                    {{#pix}} icon, mod_conference {{/pix}}
                    <span>{{joinlabel}}</span>
                </a>
                {{#haspassword}}
                    <p class="mod-conference-helper">
                        {{#pix}} i/info, core {{/pix}}
                        <span>{{joinhelper}}</span>
                    </p>
                {{/haspassword}}
            </div>

            <div class="mod-conference-statepanel mod-conference-statepanel-scheduled{{^isscheduled}} d-none{{/isscheduled}}"
                 role="status"
                 data-region="scheduled">
                <strong>{{scheduledmessage}}</strong>
                <span>{{refreshhint}}</span>
                <span class="mod-conference-countdown" data-region="countdown">{{countdownprefix}}</span>
            </div>

            <div class="mod-conference-statepanel mod-conference-statepanel-ended{{^isended}} d-none{{/isended}}"
                 role="status"
                 data-region="ended">
                {{endedmessage}}
            </div>

            <div class="visually-hidden"
                 aria-live="polite"
                 aria-atomic="true"
                 data-region="announcement"></div>
        </div>
    </div>
</div>
