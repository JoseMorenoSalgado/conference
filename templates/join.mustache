{{!
    @template mod_conference/join

    Secure handoff page shown only after the server confirms a password-protected
    conference is live.

    Example context (json):
    {
        "name": "Clinical nutrition conference",
        "status": "Available now",
        "passwordlabel": "Access password",
        "accesspassword": "482915",
        "passwordhint": "Use this password when the conference provider asks for it.",
        "continueconference": "Continue to conference",
        "meetingurl": "https://meet.example.com/room"
    }
}}
<div class="card mx-auto my-4">
    <div class="card-body p-4">
        <span class="badge text-bg-success mb-3">{{status}}</span>
        <h2 class="h3 card-title">{{name}}</h2>
        <p class="card-text">{{passwordhint}}</p>

        <div class="border rounded p-3 my-4">
            <div class="small text-uppercase fw-semibold mb-1">{{passwordlabel}}</div>
            <code class="fs-4 user-select-all">{{accesspassword}}</code>
        </div>

        <a class="btn btn-primary btn-lg" href="{{meetingurl}}">
            {{#pix}} icon, mod_conference {{/pix}}
            <span>{{continueconference}}</span>
        </a>
    </div>
</div>
